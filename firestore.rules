rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function activeUser() {
      return userExists()
        && userData().get("active", false) == true;
    }

    function isBOD() {
      return activeUser()
        && (
          userData().get("role", "") == "bod"
          || userData().get("group", "") == "bod"
        );
    }

    function membershipPath(workspaceId) {
      return /databases/$(database)/documents/workspaceMemberships/$(workspaceId + "_" + request.auth.uid);
    }

    function hasActiveMembership(workspaceId) {
      return activeUser()
        && exists(membershipPath(workspaceId))
        && get(membershipPath(workspaceId)).data.get("active", false) == true;
    }

    function canAccessWorkspace(workspaceId) {
      return activeUser()
        && (
          isBOD()
          || workspaceId == "company"
          || hasActiveMembership(workspaceId)
        );
    }

    function userPathFor(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function membershipPathFor(workspaceId, userId) {
      return /databases/$(database)/documents/workspaceMemberships/$(workspaceId + "_" + userId);
    }

    function canUserAccessWorkspace(userId, workspaceId) {
      return exists(userPathFor(userId))
        && get(userPathFor(userId)).data.get("active", false) == true
        && (
          workspaceId == "company"
          || get(userPathFor(userId)).data.get("role", "") == "bod"
          || get(userPathFor(userId)).data.get("group", "") == "bod"
          || (
            exists(membershipPathFor(workspaceId, userId))
            && get(membershipPathFor(workspaceId, userId)).data.get("active", false) == true
          )
        );
    }

    // =========================================
    // USERS
    // =========================================

    match /users/{userId} {

      allow read: if activeUser();

      /*
       * Only BOD administrators can create
       * or delete employee profiles.
       */
      allow create, delete: if isBOD();

      /*
       * BOD administrators retain full
       * update access.
       */
      allow update: if isBOD();

      /*
       * EMPLOYEE PASSWORD SETUP
       *
       * An employee may update their own
       * profile ONLY to clear
       * mustChangePassword.
       *
       * They cannot change:
       *
       * - employeeId
       * - name
       * - role
       * - group
       * - active
       * - memberships
       * - or any other profile field.
       */
      allow update: if
        activeUser()
        && request.auth.uid == userId

        /*
         * Only these two fields may differ
         * between the stored document and
         * proposed document.
         */
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "mustChangePassword",
            "notificationPreferences",
            "updatedAt"
          ])

        /*
         * The employee can only CLEAR the
         * password-change requirement.
         *
         * They cannot turn it back on.
         */
        && request.resource.data.mustChangePassword == false;
    }

    // =========================================
    // WORKSPACES
    // =========================================

    match /workspaces/{workspaceId} {

      allow read: if canAccessWorkspace(workspaceId);

      allow create, update, delete: if isBOD();
    }

    // =========================================
    // WORKSPACE MEMBERSHIPS
    // =========================================

    match /workspaceMemberships/{membershipId} {

      allow read: if activeUser();

      allow create, update, delete: if isBOD();
    }

    // =========================================
    // DATABASES
    // =========================================

    function databasePath(databaseId) {
      return /databases/$(database)/documents/databases/$(databaseId);
    }

    function canAccessDatabase(databaseId) {
      return canAccessWorkspace(
        get(databasePath(databaseId)).data.workspaceId
      );
    }

    match /databases/{databaseId} {

      allow read: if canAccessWorkspace(resource.data.workspaceId);

      allow create: if
        canAccessWorkspace(request.resource.data.workspaceId)
        && request.resource.data.createdBy == request.auth.uid;

      /*
       * Databases remain in their original workspace and retain their creator.
       * This matches the current client behavior and prevents a writer from
       * moving a database into a workspace through a metadata update.
       */
      allow update: if
        canAccessWorkspace(resource.data.workspaceId)
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if
        canAccessWorkspace(resource.data.workspaceId);

      match /rows/{rowId} {

        allow read: if canAccessDatabase(databaseId);

        allow create: if
          canAccessDatabase(databaseId)
          && request.resource.data.createdBy == request.auth.uid;

        allow update, delete: if canAccessDatabase(databaseId);
      }
    }

    // Shared table views belong to an accessible database. They only contain
    // presentation state, never row data or private per-user preferences.
    match /databaseViews/{viewId} {
      allow read: if canAccessDatabase(resource.data.databaseId);
      allow create: if
        canAccessDatabase(request.resource.data.databaseId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.workspaceId == get(databasePath(request.resource.data.databaseId)).data.workspaceId
        && request.resource.data.type == "table";
      allow update: if
        canAccessDatabase(resource.data.databaseId)
        && request.resource.data.databaseId == resource.data.databaseId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.type == "table";
      allow delete: if canAccessDatabase(resource.data.databaseId);
    }
// =========================================
// DOCUMENTS
// =========================================

match /documents/{documentId} {

  /*
   * Employees may read documents only
   * from workspaces they are allowed
   * to access.
   */
  allow read: if
    canAccessWorkspace(
      resource.data.workspaceId
    );

  /*
   * Employees may create documents only
   * inside workspaces they can access.
   */
  allow create: if
    canAccessWorkspace(
      request.resource.data.workspaceId
    );

  /*
   * A document may only be updated when
   * the employee can access both the
   * existing workspace and the proposed
   * workspace.
   *
   * This prevents moving a document into
   * or out of an unauthorized workspace.
   */
  allow update: if
    canAccessWorkspace(
      resource.data.workspaceId
    )
    &&
    canAccessWorkspace(
      request.resource.data.workspaceId
    );

  /*
   * Permanent deletion is restricted
   * to BOD administrators.
   */
  allow delete: if isBOD();
}
    // =========================================
    // TASKS
    // =========================================

    match /tasks/{taskId} {

      allow read: if
        canAccessWorkspace(
          resource.data.workspaceId
        );

      allow create: if
        canAccessWorkspace(
          request.resource.data.workspaceId
        );

      allow update: if
        canAccessWorkspace(
          resource.data.workspaceId
        )
        &&
        canAccessWorkspace(
          request.resource.data.workspaceId
        );

      allow delete: if isBOD();
    }

    // =========================================
    // MEETINGS
    // =========================================

    match /meetings/{meetingId} {

      allow read: if
        canAccessWorkspace(
          resource.data.workspaceId
        );

      allow create: if
        canAccessWorkspace(
          request.resource.data.workspaceId
        );

      allow update: if
        canAccessWorkspace(
          resource.data.workspaceId
        )
        &&
        canAccessWorkspace(
          request.resource.data.workspaceId
        );

      allow delete: if isBOD();
    }
    // =========================================
    // DOCUMENTS
    // =========================================

    match /documents/{documentId} {

      /*
       * Employees may read documents only
       * when they have access to the
       * document's workspace.
       */
      allow read: if
        canAccessWorkspace(
          resource.data.workspaceId
        );

      /*
       * Employees may create documents only
       * inside a workspace they can access.
       */
      allow create: if
        canAccessWorkspace(
          request.resource.data.workspaceId
        )
        &&
        request.resource.data.createdBy
          == request.auth.uid;

      /*
       * Employees may edit documents only
       * when they have access to both the
       * existing workspace and the workspace
       * specified by the updated document.
       */
      allow update: if
        canAccessWorkspace(
          resource.data.workspaceId
        )
        &&
        canAccessWorkspace(
          request.resource.data.workspaceId
        );

      /*
       * Permanent deletion remains an
       * administrator action.
       */
      allow delete: if isBOD();
    }
    // =========================================
    // ACTIVITY
    // =========================================

    match /activity/{activityId} {

      allow read: if
        canAccessWorkspace(
          resource.data.workspaceId
        );

      allow create: if
        canAccessWorkspace(
          request.resource.data.workspaceId
        );

      allow update, delete: if false;
    }

    match /comments/{commentId} {
      allow read: if resource.data.keys().hasAll(["workspaceId"])
        && canAccessWorkspace(resource.data.workspaceId);
      allow create: if request.resource.data.keys().hasAll(["workspaceId", "authorUid", "entityType", "entityId"])
        && canAccessWorkspace(request.resource.data.workspaceId)
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if resource.data.keys().hasAll(["workspaceId", "authorUid"])
        && canAccessWorkspace(resource.data.workspaceId)
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if resource.data.keys().hasAll(["workspaceId", "authorUid"])
        && canAccessWorkspace(resource.data.workspaceId)
        && resource.data.authorUid == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if activeUser()
        && resource.data.keys().hasAll(["recipientUid"])
        && resource.data.recipientUid == request.auth.uid;
      allow create: if request.resource.data.keys().hasAll(["workspaceId", "recipientUid", "actorUid", "entityType", "entityId"])
        && canAccessWorkspace(request.resource.data.workspaceId)
        && request.resource.data.actorUid == request.auth.uid
        && canUserAccessWorkspace(
          request.resource.data.recipientUid,
          request.resource.data.workspaceId
        );
      allow update: if activeUser()
        && resource.data.keys().hasAll(["recipientUid"])
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt", "archivedAt"]);
      allow delete: if false;
    }

    // =========================================
    // EVERYTHING ELSE
    // =========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
